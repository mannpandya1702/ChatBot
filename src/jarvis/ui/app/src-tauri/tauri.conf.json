{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis HUD",
  "version": "0.1.0",
  "identifier": "local.jarvis.hud",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "hud",
        "title": "Jarvis",
        "url": "index.html",
        "width": 380,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "center": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ws://127.0.0.1:8765 ws://localhost:8765; img-src 'self' data:"
    },
    "trayIcon": {
      "id": "jarvis-tray",
      "iconPath": "icons/icon.png",
      "tooltip": "Jarvis",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
