# ─────────────────────────────────────────────────────────────────────────────
# Sainik Sahayak — air-gap configuration.
#
# APPEND these lines to the Supabase self-hosting env file (supabase/docker/.env)
# so one env file drives the merged compose project. Values in the UPSTREAM
# section below already exist in that file — you MUST change them from the
# shipped demo defaults. Our own vars are in the SAINIK section.
# ─────────────────────────────────────────────────────────────────────────────

# == UPSTREAM Supabase vars you MUST change (already present in the bundle .env) =
#   POSTGRES_PASSWORD   strong random string; also used by the rag DB URL
#   JWT_SECRET          >= 32 random chars; sign anon/service keys with it
#   ANON_KEY            output of: node gen-jwt.mjs "$JWT_SECRET"
#   SERVICE_ROLE_KEY    output of the same command
#   DASHBOARD_PASSWORD  Studio (admin console) basic-auth password
#   SUPABASE_PUBLIC_URL the URL browsers use to reach Kong, e.g.
#                       http://192.168.10.5:8000  (the offline host's LAN addr)
#
# Enable TOTP MFA in GoTrue (required — the app enforces AAL2). Add to .env:
#   GOTRUE_MFA_ENABLED=true
#   ENABLE_ANONYMOUS_USERS=false
#   DISABLE_SIGNUP=true            # invite-only; no public signup
# (Confirm the exact GoTrue var names against your Supabase bundle version.)

# ============================ SAINIK overlay vars ============================

# --- rag-service shared secret (every rag endpoint requires it) ---
# Generate: openssl rand -hex 32
RAG_SERVICE_SECRET=change-me-openssl-rand-hex-32

# --- local LLM (Ollama) model tags — must match what stage-models.sh staged ---
GENERATION_MODEL=qwen2.5:7b-instruct
# Optional lighter model for the cheap classify/rewrite hops; blank = reuse
# GENERATION_MODEL for everything (one model to stage).
OLLAMA_CLASSIFY_MODEL=

# --- fail-closed retrieval gate (spec §3). Do NOT lower to force answers. ---
RERANK_REFUSAL_THRESHOLD=0.35

# --- optional CIDR allowlist (VPN-only deployments). Blank = allow all. ---
# Comma-separated, e.g. 10.0.0.0/8,192.168.0.0/16
IP_ALLOWLIST=

# --- host port the web UI binds to ---
WEB_PORT=3000

# --- ollama runtime image tag (record what you staged) ---
OLLAMA_IMAGE=ollama/ollama:0.5.4
