# ── Sainik Sahayak environment template (Section 16 of the build spec) ──
# Copy to .env.local (web) / .env (rag-service). NEVER commit real values.

LLM_PROVIDER=anthropic              # anthropic | ollama  (ollama for classified/air-gapped content)
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Verified against Anthropic model catalog 2026-07-19: both IDs are current & active.
# claude-sonnet-5 is the newer Sonnet at the same list price — swap here if approved.
GENERATION_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never in client bundle (CI grep enforces)

RAG_SERVICE_URL=
RAG_SERVICE_SECRET=

RERANK_REFUSAL_THRESHOLD=0.35       # tuned in Phase 7, then frozen in app_settings
MESSAGE_RETENTION_DAYS=90
IP_ALLOWLIST=                       # optional, comma-separated CIDRs for VPN-only deployments
TRUSTED_PROXY_COUNT=0               # reverse proxies in front of the app: 0 direct, 1 behind Caddy/Vercel.
                                    # Must match reality if IP_ALLOWLIST is set — too low and the
                                    # leftmost X-Forwarded-For entry (caller-controlled) is trusted.

# ── rag-service only (services/rag, prefix RAG_) ──
RAG_SUPABASE_URL=                   # Supabase base URL; how the ingester reads the private `kb` bucket.
RAG_SUPABASE_SERVICE_ROLE_KEY=      # without these two, admin-console uploads process no further
RAG_DATABASE_URL=                   # direct/session-pooler Postgres URI (NOT the 6543 transaction pooler)
RAG_INGEST_CONCURRENCY=1            # simultaneous background ingests; >1 needs RAM to match
