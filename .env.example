# ── Sainik Sahayak environment template (Section 16 of the build spec) ──
# Copy to .env.local (web) / .env (rag-service). NEVER commit real values.

LLM_PROVIDER=anthropic              # anthropic | ollama  (ollama for classified/air-gapped content)
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Verified against Anthropic model catalog 2026-07-19: both IDs are current & active.
# claude-sonnet-5 is the newer Sonnet at the same list price — swap here if approved.
GENERATION_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never in client bundle (CI grep enforces)

RAG_SERVICE_URL=
RAG_SERVICE_SECRET=

RERANK_REFUSAL_THRESHOLD=0.35       # tuned in Phase 7, then frozen in app_settings
MESSAGE_RETENTION_DAYS=90
IP_ALLOWLIST=                       # optional, comma-separated CIDRs for VPN-only deployments
